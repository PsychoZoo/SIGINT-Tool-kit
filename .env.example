# Copied to .env by ./toolkit.sh on first run, with random passwords filled in.

# Merge integrations and your modules into the stack whenever you run `docker compose`.
COMPOSE_FILE=docker-compose.yml:integrations.yml:modules/compose.yml
COMPOSE_PROJECT_NAME=sigint
# Set by ./toolkit.sh from ROLE (and the Cloudflare settings below).
COMPOSE_PROFILES=master

# --- This device ---------------------------------------------------------------
# master: runs the database, dashboard and broker that all nodes report to.
# node:   runs programs and sends everything to the master (set by ./toolkit.sh join).
ROLE=master
# Name of this device; every event it produces is tagged with it.
NODE_NAME=master

# Internal broker account used by this device's own programs.
MQTT_USERNAME=local
MQTT_PASSWORD=change-me

POSTGRES_USER=sigint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigint

# Host address the database, broker and API listen on. 127.0.0.1 keeps them
# private to this machine; use 0.0.0.0 to reach them from your network (put the
# API behind authentication first: it has no login of its own).
BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

LOG_LEVEL=INFO
# Delete events older than this many days (0 = keep forever).
EVENT_RETENTION_DAYS=0

# Demo simulator messages per second.
SIM_RATE=1

# --- Multiple devices ----------------------------------------------------------
# Master: address and port nodes connect to. 0.0.0.0 = every network interface.
NODE_LISTEN_ADDRESS=0.0.0.0
NODE_PORT=1884
# Master: Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). When set,
# ./toolkit.sh up also starts cloudflared. MASTER_CLOUDFLARE_HOSTNAME is the
# public hostname you routed to tcp://broker:1884, e.g. mqtt.example.com.
CLOUDFLARE_TUNNEL_TOKEN=
MASTER_CLOUDFLARE_HOSTNAME=

# Master: reach the dashboard from anywhere through the tunnel, behind a
# Cloudflare Access login (docs/GUIDE.md, "Reach the dashboard from anywhere").
# Route DASHBOARD_CLOUDFLARE_HOSTNAME to http://api-public:8080 in the tunnel:
# that instance refuses every request without a valid Access login for this team
# and application (AUD tag). The tunnel can't reach the login-free local API.
DASHBOARD_CLOUDFLARE_HOSTNAME=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Node: set by ./toolkit.sh join.
MASTER_ADDRESS=
NODE_PASSWORD=
# Cloudflare Access service token, if the master's hostname is protected by Access.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
# Node: topics to receive from the master besides commands for this node,
# space-separated. Default: watchlist alerts. Add e.g. sigint/+/+/data/adsb to
# get every node's ADS-B data here as well.
NODE_IMPORT_TOPICS=sigint/+/+/data/alert

# --- Flashing nodes (./toolkit.sh flash-node) -----------------------------------
# Remembered answers, so the next card needs fewer. The Wi-Fi password is never
# stored here (give it with FLASH_WIFI_PASSWORD in the environment to skip the prompt).
FLASH_TARGET=pi
FLASH_PROGRAMS=demo
FLASH_WIFI_SSID=
FLASH_WIFI_COUNTRY=US
FLASH_SSH_KEY=
# Programs ./toolkit.sh setup starts on the master.
SETUP_PROGRAMS=demo

# --- Kismet (profile: kismet) -------------------------------------------------
KISMET_USER=sigint
KISMET_PASSWORD=change-me
# Space-separated capture sources, e.g. "wlan1 hci0". The Wi-Fi adapter must
# support monitor mode; don't use the one this machine is connected through.
KISMET_SOURCES=
KISMET_PORT=2501
KISMET_POLL_SECONDS=30

# --- ChirpStack LoRaWAN (profile: lora) ---------------------------------------
CHIRPSTACK_API_SECRET=change-me
CHIRPSTACK_PORT=8090
# Region of your gateways: eu868, us915_0, us915_1, au915_0, as923, in865, kr920, ...
LORA_REGION=eu868
LORA_BIND_ADDRESS=0.0.0.0

# --- SDR programs (profiles: adsb, ais, ism, aprs, or sdr for all) -------------
# Each program needs its own RTL-SDR. Set unique serials with `rtl_eeprom -s <serial>`
# and list them here; leave blank to use the first dongle found.
ADSB_SDR_SERIAL=
AIS_SDR_SERIAL=
RTL433_SDR_SERIAL=
APRS_SDR_SERIAL=

# Your antenna location (used by the ADS-B map and range stats).
STATION_LAT=
STATION_LON=
TZ=UTC

ADSB_MAP_PORT=8078
ADSB_GAIN=auto
# Seconds between stored positions per aircraft.
ADSB_JSON_INTERVAL=5

AIS_WEB_PORT=8100
AIS_ARGS=

# Extra arguments for rtl_433, e.g. "-f 868M" or "-f 915M".
RTL433_ARGS=

# 144.390M in North America, 144.800M in Europe.
APRS_FREQ=144.390M
APRS_GAIN=42
