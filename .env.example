# Copied to .env by `./toolkit.sh up` on first run (with a random password).

# Merge your modules into the stack whenever you run `docker compose`.
COMPOSE_FILE=docker-compose.yml:modules/compose.yml
COMPOSE_PROJECT_NAME=sigint

POSTGRES_USER=sigint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigint

# Host address the database, broker and API listen on. 127.0.0.1 keeps them
# private to this machine; use 0.0.0.0 to reach them from your network (and add
# broker authentication first).
BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

LOG_LEVEL=INFO
# Delete events older than this many days (0 = keep forever).
EVENT_RETENTION_DAYS=0

# Demo simulator messages per second.
SIM_RATE=1
# Extra arguments for rtl_433, e.g. "-f 868M -R 0 -R 19".
RTL433_ARGS=
