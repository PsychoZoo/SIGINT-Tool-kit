# Copied to .env by `./toolkit.sh up` on first run (with a random password).

# Merge integrations and your modules into the stack whenever you run `docker compose`.
COMPOSE_FILE=docker-compose.yml:integrations.yml:modules/compose.yml
COMPOSE_PROJECT_NAME=sigint

POSTGRES_USER=sigint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigint

# Host address the database, broker and API listen on. 127.0.0.1 keeps them
# private to this machine; use 0.0.0.0 to reach them from your network (and add
# broker authentication first).
BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

LOG_LEVEL=INFO
# Delete events older than this many days (0 = keep forever).
EVENT_RETENTION_DAYS=0

# Demo simulator messages per second.
SIM_RATE=1

# --- Kismet (profile: kismet) -------------------------------------------------
KISMET_USER=sigint
KISMET_PASSWORD=change-me
# Space-separated capture sources, e.g. "wlan1 hci0". The Wi-Fi adapter must
# support monitor mode; don't use the one this machine is connected through.
KISMET_SOURCES=
KISMET_PORT=2501
KISMET_POLL_SECONDS=30

# --- ChirpStack LoRaWAN (profile: lora) ---------------------------------------
CHIRPSTACK_API_SECRET=change-me
CHIRPSTACK_PORT=8090
# Region of your gateways: eu868, us915_0, us915_1, au915_0, as923, in865, kr920, ...
LORA_REGION=eu868
LORA_BIND_ADDRESS=0.0.0.0

# --- SDR programs (profiles: adsb, ais, ism, aprs, or sdr for all) -------------
# Each program needs its own RTL-SDR. Set unique serials with `rtl_eeprom -s <serial>`
# and list them here; leave blank to use the first dongle found.
ADSB_SDR_SERIAL=
AIS_SDR_SERIAL=
RTL433_SDR_SERIAL=
APRS_SDR_SERIAL=

# Your antenna location (used by the ADS-B map and range stats).
STATION_LAT=
STATION_LON=
TZ=UTC

ADSB_MAP_PORT=8078
ADSB_GAIN=auto
# Seconds between stored positions per aircraft.
ADSB_JSON_INTERVAL=5

AIS_WEB_PORT=8100
AIS_ARGS=

# Extra arguments for rtl_433, e.g. "-f 868M" or "-f 915M".
RTL433_ARGS=

# 144.390M in North America, 144.800M in Europe.
APRS_FREQ=144.390M
APRS_GAIN=42
